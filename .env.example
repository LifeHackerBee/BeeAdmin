# 环境变量模板（2026-11-12 认证为本地账号，前端零密钥）
# 注意：VITE_ 前缀的变量会被打进浏览器可见的 JS 包，永远不要放密钥！

# 后端 API 地址
VITE_HYPERLIQUID_TRADER_API_URL=https://hyperliquid-ai-trader.hackerbee.life

# 是否允许注册页入口（默认: false；账号由管理员直接在后端 local_users 表创建）
VITE_ALLOW_SIGNUP=false

# 是否允许忘记密码功能（默认: false）
VITE_ALLOW_FORGOT_PASSWORD=false

# 上游服务的密钥一律配置在后端（hyperliquid-ai-trader/.env），
# 前端经 /api/proxy/* 代理访问，不再持有任何密钥。
